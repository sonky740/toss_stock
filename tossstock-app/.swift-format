{
  // swift-format 설정 — TossStock
  //
  // 실행 (이 디렉토리에서):
  //   swift format lint -r Sources          검사만 (위반이 있어도 exit 0)
  //   swift format lint --strict -r Sources 검사 + 위반 시 exit 실패 (게이트용)
  //   swift format -i <파일>                 해당 파일 자동 정리
  //
  // 이 도구는 Swift 6/Xcode 16 부터 툴체인에 번들된 Apple 공식 포매터다. 설치가 필요 없다.
  // 서드파티 SwiftFormat(nicklockwood, 설정 파일 `.swiftformat`)과는 **다른 도구**다 — 혼동 금지.
  //
  // 주의 1: `rules` 키를 쓰면 기본 룰맵 전체가 *대체*된다(병합 아님). 세 개만 적으면
  //         나머지 40여 개가 전부 꺼진다. 그래서 여기선 `rules` 를 아예 두지 않는다.
  // 주의 2: 알 수 없는 최상위 키는 경고 없이 무시된다. 오타 나면 설정이 조용히 안 먹는다.
  //
  "version": 1,

  // 기본값 유지. Google/Airbnb Swift 스타일 가이드와 apple/swift 저장소가 모두 2칸이다
  // (4칸은 Xcode 에디터 기본값이라 앱 코드에 흔한 것이지 Swift 권장값이 아니다).
  // 이 저장소도 원래 4칸이었으나 전 파일 일괄 재포맷 시점에 기본값으로 맞췄다.
  "indentation": { "spaces": 2 },

  // 실측 최장 줄 170자. 기본값 100은 너무 좁아 기존 코드를 대량으로 쪼갠다.
  "lineLength": 120,

  // 이미 사람이 의미 있게 끊어 둔 줄바꿈을 포매터가 다시 합치지 않게 한다.
  "respectsExistingLineBreaks": true
}
